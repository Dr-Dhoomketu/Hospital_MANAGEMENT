{
  "version": 2,
  "buildCommand": "pnpm install && pnpm --filter @workspace/ashoka-care-hospital run build",
  "outputDirectory": "artifacts/ashoka-care-hospital/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "https://clerk.ashokacaremedic.vercel.app/__clerk/:path*"
    },
    {
      "source": "/((?!assets|favicon|robots).*)",
      "destination": "/index.html"
    }
  ]
}
