{
  "version": 2,
  "buildCommand": "pnpm install && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/ashoka-care-hospital run build",
  "outputDirectory": "artifacts/ashoka-care-hospital/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    {
      "src": "/((?!assets|favicon\\.svg|robots\\.txt).*)",
      "dest": "/index.html"
    }
  ]
}
